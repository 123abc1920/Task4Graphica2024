<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.input.KeyCodeCombination?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="anchorPane" nodeOrientation="LEFT_TO_RIGHT" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cgvsu.GuiController">
    <MenuBar>
        <Menu mnemonicParsing="false" text="File">
            <MenuItem mnemonicParsing="false" onAction="#onOpenModelMenuItemClick" text="Load Model">
            <accelerator>
                <KeyCodeCombination alt="UP" code="F" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
            </accelerator>
            </MenuItem>
        </Menu>
        <Menu mnemonicParsing="false" text="Camera Options">
            <MenuItem mnemonicParsing="false" onAction="#handleCameraForward" text="Forward">
                <accelerator>
                    <KeyCodeCombination alt="UP" code="UP" control="UP" meta="UP" shift="UP" shortcut="UP" />
                </accelerator>
            </MenuItem>
            <MenuItem mnemonicParsing="false" onAction="#handleCameraBackward" text="Backward">
                <accelerator>
                    <KeyCodeCombination alt="UP" code="DOWN" control="UP" meta="UP" shift="UP" shortcut="UP" />
                </accelerator>
            </MenuItem>
            <MenuItem mnemonicParsing="false" onAction="#handleCameraLeft" text="Left">
                <accelerator>
                    <KeyCodeCombination alt="UP" code="LEFT" control="UP" meta="UP" shift="UP" shortcut="UP" />
                </accelerator>
            </MenuItem>
            <MenuItem mnemonicParsing="false" onAction="#handleCameraRight" text="Right">
                <accelerator>
                    <KeyCodeCombination alt="UP" code="RIGHT" control="UP" meta="UP" shift="UP" shortcut="UP" />
                </accelerator>
            </MenuItem>
            <MenuItem mnemonicParsing="false" onAction="#handleCameraUp" text="Up">
                <accelerator>
                    <KeyCodeCombination alt="UP" code="W" control="UP" meta="UP" shift="UP" shortcut="UP" />
                </accelerator>
            </MenuItem>
            <MenuItem mnemonicParsing="false" onAction="#handleCameraDown" text="Down">
                <accelerator>
                    <KeyCodeCombination alt="UP" code="S" control="UP" meta="UP" shift="UP" shortcut="UP" />
                </accelerator>
            </MenuItem>
        </Menu>
      <Menu mnemonicParsing="false" onAction="#handleThemeChange" text="View">
        <items>
          <MenuItem mnemonicParsing="false" text="Change Theme">
               <accelerator>
                  <KeyCodeCombination alt="UP" code="C" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
               </accelerator></MenuItem>
        </items>
      </Menu>
    </MenuBar>

    <Canvas fx:id="canvas" height="870" onMouseDragged="#handleMouseDragged" onMousePressed="#handleMousePressed" onScroll="#handleMouseScroll" width="1400.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="30.0" />
   <VBox fx:id="vBoxMain" alignment="TOP_CENTER" maxWidth="300.0" minWidth="200.0" nodeOrientation="LEFT_TO_RIGHT" onMouseClicked="#handleMouseClickedVBoxMain" prefWidth="250.0" styleClass="vBoxMain" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <children>
         <VBox fx:id="VBoxCamera" alignment="CENTER" maxHeight="1.7976931348623157E308" styleClass="vBoxFirst">
            <children>
               <StackPane styleClass="stakePaneFirst">
                  <children>
                     <Label alignment="CENTER" contentDisplay="CENTER" text="Камера" textAlignment="CENTER" />
                  </children>
               </StackPane>
               <Label maxWidth="1.7976931348623157E308" styleClass="labelPos" text="Position" textAlignment="JUSTIFY" />
               <HBox alignment="CENTER_LEFT">
                  <children>
                     <Label text="x">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></Label>
                     <TextField fx:id="textFieldPosX" focusTraversable="false" maxHeight="-Infinity" prefWidth="50.0">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></TextField>
                     <Label text="y">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></Label>
                     <TextField fx:id="textFieldPosY" focusTraversable="false" maxHeight="-Infinity" prefWidth="50.0">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></TextField>
                     <Label text="z">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></Label>
                     <TextField fx:id="textFieldPosZ" focusTraversable="false" maxHeight="-Infinity" prefWidth="50.0">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></TextField>
                  </children>
               </HBox>
               <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="labelTar" text="Target">
                  <VBox.margin>
                     <Insets />
                  </VBox.margin></Label>
               <HBox alignment="CENTER_LEFT">
                  <children>
                     <Label text="x">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></Label>
                     <TextField fx:id="textFieldTarX" focusTraversable="false" maxHeight="-Infinity" prefWidth="50.0">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></TextField>
                     <Label text="y">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></Label>
                     <TextField fx:id="textFieldTarY" focusTraversable="false" maxHeight="-Infinity" prefWidth="50.0">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></TextField>
                     <Label text="z">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></Label>
                     <TextField fx:id="textFieldTarZ" focusTraversable="false" maxHeight="-Infinity" prefWidth="50.0">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></TextField>
                  </children>
               </HBox>
               <Label text="Список камер" />
               <VBox styleClass="vBoxThird">
                  <children>
                     <ChoiceBox fx:id="cameraList" maxWidth="1.7976931348623157E308" />
                  </children>
               </VBox>
            </children>
            <opaqueInsets>
               <Insets />
            </opaqueInsets>
         </VBox>
         <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" styleClass="vBoxSecond">
            <children>
               <StackPane alignment="TOP_CENTER" styleClass="stakePaneSecond">
                  <children>
                     <Label text="Растеризация" />
                  </children>
               </StackPane>
               <HBox maxWidth="1.7976931348623157E308" styleClass="hBoxLines">
                  <children>
                     <Label text="Цвет линий" />
                     <ColorPicker fx:id="colorPickerLines" focusTraversable="false" onAction="#handleColorPickerLinesOnAction" styleClass="picker">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></ColorPicker>
                  </children>
               </HBox>
               <HBox maxWidth="1.7976931348623157E308">
                  <children>
                     <Label text="Цвет модели" />
                     <ColorPicker fx:id="colorPickerModel" focusTraversable="false" onAction="#handleColorPickerModelOnAction" styleClass="picker" />
                  </children>
               </HBox>
               <HBox maxWidth="1.7976931348623157E308">
                  <children>
                     <Label text="Линии" />
                     <CheckBox fx:id="checkBoxLines" focusTraversable="false" mnemonicParsing="false" onAction="#handleCheckBoxLinesOnAction" />
                     <HBox>
                        <children>
                           <Label text="Освещение" />
                           <CheckBox fx:id="checkBoxLight" focusTraversable="false" mnemonicParsing="false" onAction="#handleCheckBoxLightOnAction" />
                        </children>
                     </HBox>
                     <HBox>
                        <children>
                           <Label text="Текстура" />
                           <CheckBox fx:id="checkBoxTexture" focusTraversable="false" mnemonicParsing="false" onAction="#handleCheckBoxTextureOnAction" />
                        </children>
                     </HBox>
                  </children>
               </HBox>
               <HBox maxWidth="1.7976931348623157E308">
                  <children>
                     <TextField fx:id="textureText" promptText="Модель не открыта" />
                     <Button fx:id="addTextureBtn" mnemonicParsing="false" text="Ok" />
                     <Button fx:id="chooseFileBtn" mnemonicParsing="false" text="Files..." />
                  </children>
               </HBox>
            </children>
         </VBox>
         <VBox styleClass="vBoxThird">
            <children>
               <StackPane styleClass="stakePaneThird">
                  <children>
                     <Label text="Освещение" />
                  </children>
               </StackPane>
            </children>
         </VBox>
      </children></VBox>
</AnchorPane>
