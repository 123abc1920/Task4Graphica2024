<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.input.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="anchorPane" nodeOrientation="LEFT_TO_RIGHT" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cgvsu.GuiController">
    <MenuBar>
        <Menu mnemonicParsing="false" text="File">
            <MenuItem mnemonicParsing="false" onAction="#onOpenModelMenuItemClick" text="Load Model">
            <accelerator>
                <KeyCodeCombination alt="UP" code="F" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
            </accelerator>
            </MenuItem>
        </Menu>
        <Menu mnemonicParsing="false" text="Camera Options">
            <MenuItem mnemonicParsing="false" onAction="#handleCameraForward" text="Forward">
                <accelerator>
                    <KeyCodeCombination alt="UP" code="UP" control="UP" meta="UP" shift="UP" shortcut="UP" />
                </accelerator>
            </MenuItem>
            <MenuItem mnemonicParsing="false" onAction="#handleCameraBackward" text="Backward">
                <accelerator>
                    <KeyCodeCombination alt="UP" code="DOWN" control="UP" meta="UP" shift="UP" shortcut="UP" />
                </accelerator>
            </MenuItem>
            <MenuItem mnemonicParsing="false" onAction="#handleCameraLeft" text="Left">
                <accelerator>
                    <KeyCodeCombination alt="UP" code="LEFT" control="UP" meta="UP" shift="UP" shortcut="UP" />
                </accelerator>
            </MenuItem>
            <MenuItem mnemonicParsing="false" onAction="#handleCameraRight" text="Right">
                <accelerator>
                    <KeyCodeCombination alt="UP" code="RIGHT" control="UP" meta="UP" shift="UP" shortcut="UP" />
                </accelerator>
            </MenuItem>
            <MenuItem mnemonicParsing="false" onAction="#handleCameraUp" text="Up">
                <accelerator>
                    <KeyCodeCombination alt="UP" code="W" control="UP" meta="UP" shift="UP" shortcut="UP" />
                </accelerator>
            </MenuItem>
            <MenuItem mnemonicParsing="false" onAction="#handleCameraDown" text="Down">
                <accelerator>
                    <KeyCodeCombination alt="UP" code="S" control="UP" meta="UP" shift="UP" shortcut="UP" />
                </accelerator>
            </MenuItem>
        </Menu>
      <Menu mnemonicParsing="false" onAction="#handleThemeChange" text="View">
        <items>
          <MenuItem mnemonicParsing="false" text="Change Theme">
               <accelerator>
                  <KeyCodeCombination alt="UP" code="C" control="DOWN" meta="UP" shift="UP" shortcut="UP" />
               </accelerator></MenuItem>
        </items>
      </Menu>
    </MenuBar>

    <Canvas fx:id="canvas" height="870" onMouseDragged="#handleMouseDragged" onMousePressed="#handleMousePressed" onScroll="#handleMouseScroll" width="1400.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="30.0" />
   <VBox fx:id="VBoxMain" alignment="TOP_CENTER" maxWidth="300.0" minWidth="200.0" nodeOrientation="LEFT_TO_RIGHT" styleClass="vBoxMain" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <children>
         <VBox fx:id="VBoxCamera" alignment="CENTER" VBox.vgrow="NEVER">
            <children>
               <Label alignment="CENTER" contentDisplay="CENTER" text="Камера" textAlignment="CENTER">
                  <font>
                     <Font size="16.0" />
                  </font>
               </Label>
               <Label maxWidth="1.7976931348623157E308" text="Position" textAlignment="JUSTIFY" />
               <HBox alignment="CENTER_LEFT">
                  <children>
                     <Label text="x">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></Label>
                     <TextField fx:id="textFieldPosX" focusTraversable="false" maxWidth="30.0" minWidth="30.0" prefWidth="30.0">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></TextField>
                     <Label text="y">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></Label>
                     <TextField fx:id="textFieldPosY" focusTraversable="false" maxWidth="30.0" minWidth="30.0" prefWidth="30.0">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></TextField>
                     <Label text="z">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></Label>
                     <TextField fx:id="textFieldPosZ" focusTraversable="false" maxWidth="30.0" minWidth="30.0" prefWidth="30.0">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></TextField>
                  </children>
               </HBox>
               <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="Target">
                  <VBox.margin>
                     <Insets />
                  </VBox.margin></Label>
               <HBox alignment="CENTER_LEFT">
                  <children>
                     <Label text="x">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></Label>
                     <TextField focusTraversable="false" maxWidth="30.0" minWidth="30.0" prefWidth="30.0">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></TextField>
                     <Label text="y">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></Label>
                     <TextField focusTraversable="false" maxWidth="30.0" minWidth="30.0" prefWidth="30.0">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></TextField>
                     <Label text="z">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></Label>
                     <TextField focusTraversable="false" maxWidth="30.0" minWidth="30.0" prefWidth="30.0">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></TextField>
                  </children>
               </HBox>
            </children>
         </VBox>
      </children></VBox>
</AnchorPane>
